
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum StatusCompra {
  PENDENTE
  PAGO
  CANCELADO
}

model User {
   id  Int   @id @default(autoincrement())
   name  String
   email String @unique
   password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compras Compra[]
}

model Curso {
  id Int @id @default(autoincrement())
  title String 
  description String

  aula Aula[]

  compras Compra[]
  
}

model Aula {
  id Int @id @default(autoincrement())
  title String
  videoUrl String
 
  cursoId Int
  curso Curso @relation(fields: [cursoId], references: [id])
} 



model Compra {
  id Int @id @default(autoincrement())
  userId Int 
  cursoId Int 
  status StatusCompra @default(PENDENTE)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  curso Curso @relation(fields: [cursoId], references: [id])
}